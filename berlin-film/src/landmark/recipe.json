    "en": {
      "title": "The Gate That Remembered Berlin",
      "place": "Brandenburg Gate, Pariser Platz, Berlin",
      "eyebrow": "A neoclassical triumphal threshold",
      "text": "Twelve fluted Doric columns, five central passageways, flanking neoclassical halls, and Schadow’s copper Quadriga, assembled course by course across centuries of war, division, and peaceful unity.",
      "disclaimer": "An interpretive architectural diorama of the Brandenburger Tor with simplified classical proportions; not a survey.",
      "views": {
        "overview": "Overview",
        "colonnade": "Doric Colonnade",
        "quadriga": "Copper Quadriga",
        "crown": "Pariser Platz"
      }
    },
    "zh-CN": {
      "title": "记住柏林的勃兰登堡门",
      "place": "柏林巴黎广场，勃兰登堡门",
      "eyebrow": "新古典主义凯旋门",
      "text": "十二根多立克石柱、五重通道、南北侧翼殿堂与沙多的铜铸四马战车，在战争、分裂与和平统一的历史中逐层砌筑。",
      "disclaimer": "勃兰登堡门的新古典主义建筑示意模型，比例和细部经过适度简化，并非测绘。",
      "views": {
        "overview": "全景",
        "colonnade": "列柱廊",
        "quadriga": "四马战车",
        "crown": "巴黎广场"
      }
