      "end": 60,
      "lines": [
        "In 1080, in Huangzhou, he",
        "farmed a plot of land."
      ],
      "em": [
        "farmed"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S13",
      "start": 60.333333333333336,
      "end": 65.46666666666667,
      "lines": [
        "He named it Dongpo, and",
        "himself Dongpo Jushi."
      ],
      "em": [
        "Dongpo Jushi"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S14",
      "start": 65.8,
      "end": 70.9,
      "lines": [
        "He roamed hills and rivers with",
        "fishermen and woodcutters."
      ],
      "em": [
        "fishermen and woodcutters"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S15",
      "start": 71.23333333333333,
      "end": 76.36666666666666,
      "lines": [
        "Huangzhou was home from 1080 to 1084."
      ],
      "em": [
        "1080 to 1084"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S16",
      "start": 76.7,
      "end": 81.83333333333333,
      "lines": [
        "Records say in 1082 he wrote",
        "the First Ode on the Red Cliff."
      ],
      "em": [
        "First Ode on the Red Cliff"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S17",
      "start": 82.16666666666667,
      "end": 87.26666666666667,
      "lines": [
        "In 1084 he left Huangzhou for Ruzhou."
      ],
      "em": [
        "Ruzhou"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S18",
      "start": 87.6,
      "end": 92.73333333333333,
      "lines": [
        "In 1094 he was exiled again, to Huizhou."
      ],
      "em": [
        "Huizhou"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S19",
      "start": 93.06666666666666,
      "end": 98.16666666666667,
      "lines": [
        "In 1097 he was placed",
        "under watch in Changhua."
      ],
      "em": [
        "Changhua"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S20",
      "start": 98.5,
      "end": 103.63333333333334,
      "lines": [
        "In 1100 his place of",
        "exile moved to Lianzhou."
      ],
      "em": [
        "Lianzhou"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S21",
      "start": 103.96666666666667,
      "end": 109.1,
      "lines": [
        "Would the road north ever open?"
      ],
      "em": [
        "north"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S22",
      "start": 109.43333333333334,
      "end": 120,
      "lines": [
        "Hangzhou, Mizhou, Xuzhou, Huzhou,",
        "Huangzhou, Huizhou, Changhua."
      ],
      "em": [
        "Huangzhou"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S23",
      "start": 120.33333333333333,
      "end": 125.46666666666667,
      "lines": [
        "In 1101 he died in Changzhou."
      ],
      "em": [
        "1101"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S24",
      "start": 125.8,
      "end": 130.9,
      "lines": [
        "From exile to exile, he",
        "kept the name Dongpo."
      ],
      "em": [
        "Dongpo"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S25",
      "start": 131.23333333333332,
      "end": 139.1,
      "lines": [
        "Courtesy name Zizhan,",
        "art name Dongpo Jushi."
      ],
      "em": [
        "Dongpo Jushi"
      ],
      "dir": "ltr"
    },
    {
      "shot": "S26",
      "start": 139.43333333333334,
      "end": 144.53333333333333,
      "lines": [
        "Could you turn exile into poetry?"
      ],
      "em": [
        "poetry"
      ],
      "dir": "ltr"
    }
  ],
