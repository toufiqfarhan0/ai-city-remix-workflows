 "copy": {
  "en": {
   "title": "Statue of Liberty",
   "place": "Liberty Island, New York",
   "eyebrow": "A copper statue on an iron frame, dedicated in 1886",
   "text": "An eleven-point star fort, a stepped foundation and a granite pedestal, then an iron pylon with armature bars and a thin copper skin hung on it plate by plate, finished with the tablet, the crown's seven rays and the torch. Dismantle it to cut the front of the skin away and see the frame inside.",
   "disclaimer": "An interpretive model of the Statue of Liberty with simplified proportions and drapery; not a survey.",
   "views": {
    "overview": "Overview",
    "torch": "Torch",
    "crown": "Crown",
    "frame": "Inside the frame"
   }
  },
  "zh-CN": {
   "title": "自由女神像",
   "place": "纽约自由岛",
   "eyebrow": "铁架上的铜像，1886 年落成",
   "text": "先建十一角星形堡垒、阶梯式基础和花岗岩基座，再立起铁塔骨架和支撑拉杆，把薄铜皮一片片挂上去，最后装上书板、王冠的七道光芒和火炬。拖动拆解，正面铜皮被剖开，就能看到里面的铁架。",
   "disclaimer": "自由女神像的示意模型，比例和衣褶经过简化，并非测绘。",
   "views": {
    "overview": "全景",
    "torch": "火炬",
    "crown": "王冠",
    "frame": "内部铁架"
   }
  }
